# Copia este archivo como C:\Users\<usuario>\.hermes\.env
# Nunca compartas el token: quien lo tenga controla tu bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Respaldo cifrado en Azure. Guarda la contraseña también fuera de esta computadora.
AZURE_BACKUP_SAS_URL=
HERMES_BACKUP_PASSWORD=

# Búsqueda en internet (tavily.com)
TAVILY_API_KEY=

# Claude con tu suscripción para conversar y resumir búsquedas (local o claude).
# Si no está disponible, Hermes vuelve solo al modelo local.
# HERMES_LLM_MODE=local
# HERMES_CLAUDE_MODEL=claude-opus-5-5

# Opcionales (estos son los valores por defecto)
# HERMES_BACKUP_TIME=03:00
# HERMES_HOME_VOICE=on
# HERMES_WAKE_WORD=hermes
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=hermes
# HERMES_SUMMARY_TIME=07:30
# HERMES_DEFAULT_TASK_TIME=09:00
# HERMES_CATEGORIES=trabajo,negocios,casa,personal,salud,finanzas,reptiles
